root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,js,mjs,cjs,json,md}]
indent_style = tab
indent_size = 4

[*.ts]
# Extensionless relative imports resolve at runtime through jiti (pi) and under
# moduleResolution "Bundler" for the typechecker.

[*.md]
trim_trailing_whitespace = false
